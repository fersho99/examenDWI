# Copia este archivo como .env.local en la raíz del repo y llena los valores.
# .env.local nunca se sube al repositorio.

# --- Neon ---------------------------------------------------------------
# Conexión pooled (el host lleva "-pooler"): la usa la web.
DATABASE_URL=
# Conexión directa (sin "-pooler"): solo para npm run db:migrate.
DATABASE_URL_UNPOOLED=

# --- Ingesta ------------------------------------------------------------
# Secreto de al menos 32 caracteres para /api/internal/ingest.
# Genéralo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- Apps Android y reloj ------------------------------------------------
# prod: carga BLOQUE21_URL. dev: usa tu servidor local por adb reverse.
BLOQUE21_ENV=prod
# Dominio desplegado en Vercel, sin barra final. Ej.: https://bloque21.vercel.app
BLOQUE21_URL=

# Número de serie del teléfono (adb devices). Vacío si solo conectas uno.
ADB_PHONE=
# IP:PUERTO de Depuración inalámbrica del reloj (cambia cuando se reinicia).
ADB_WATCH=

# Opcional: JDK 21 para Gradle si no está en la ruta habitual.
BLOQUE21_JAVA_HOME=
